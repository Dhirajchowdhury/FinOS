# FinOS .env.example — safe to commit; NEVER put real secrets here.

# LLM provider
TRADINGAGENTS_LLM_PROVIDER=google
TRADINGAGENTS_DEEP_THINK_LLM=gemini-3.8-flash
TRADINGAGENTS_QUICK_THINK_LLM=gemini-3.8-flash
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_TEMPERATURE=0.0
TRADINGAGENTS_MAX_TOKENS=8192
TRADINGAGENTS_LLM_MAX_RETRIES=3

# Put a key only for the provider you use
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional compatible/local LLMs
OPENAI_COMPATIBLE_API_KEY=
TRADINGAGENTS_LLM_BACKEND_URL=
OLLAMA_BASE_URL=

# Market/news providers
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional SEC EDGAR (use a valid contact in the user agent)
# SEC_EDGAR_USER_AGENT=Your Name your@email.com

# Optional TigerData / TimescaleDB. Leave blank to disable.
TIGERDATA_DATABASE_URL=
TIGERDATA_REQUIRE_TIMESCALEDB=false

# Optional AWS Bedrock
AWS_BEARER_TOKEN_BEDROCK=
AWS_DEFAULT_REGION=us-west-2
AWS_PROFILE=

# Runtime / cache
TRADINGAGENTS_RESULTS_DIR=
TRADINGAGENTS_CACHE_DIR=
TRADINGAGENTS_MEMORY_LOG_PATH=
TRADINGAGENTS_BENCHMARK_TICKER=SPY
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Optional provider tuning
TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
TRADINGAGENTS_ANTHROPIC_EFFORT=high
